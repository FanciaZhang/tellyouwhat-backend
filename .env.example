APP_ENV=development
APP_ATTEST_ENV=development
PORT=8080
STORAGE_MODE=mysql
DATABASE_DSN=health_ai:local-only-password@tcp(127.0.0.1:3306)/health_ai?charset=utf8mb4&collation=utf8mb4_0900_ai_ci
REDIS_URL=redis://127.0.0.1:6379/0
PAYLOAD_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_BUNDLE_ID=cn.tellyouwhat.healthapp
APP_ATTEST_ROOT_PEM_PATH=/config/Apple_App_Attestation_Root_CA.pem
ALLOWED_APP_BUILDS=100
DEV_ACTIVATION_SECRET=ROTATABLE_DEVELOPMENT_SECRET
WORKER_INTERNAL_SECRET=ROTATABLE_WORKER_SECRET
WORKER_ASYNC_URL=https://worker.example/internal/jobs/process
JOB_CAPABILITY_SECRET=ROTATABLE_RANDOM_SECRET_AT_LEAST_32_BYTES
SCHEMA_MANIFEST_PATH=/config/schema-manifest.json
TRUSTED_CLIENT_IP_HEADER=X-Real-IP
ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=SECRET
ARK_ENDPOINT_VOICE_TRANSCRIPTION=ep-placeholder
ARK_ENDPOINT_MEAL_PHOTO_CAPTURE=ep-placeholder
ARK_ENDPOINT_MEAL_TEXT_CAPTURE=ep-placeholder
ARK_ENDPOINT_MEAL_DECISION=ep-placeholder
ARK_ENDPOINT_DIET_ANALYSIS=ep-placeholder
ARK_ENDPOINT_HEALTH_NUTRITION_ANALYSIS=ep-placeholder
ARK_ENDPOINT_HEALTH_BEHAVIOR_ANALYSIS=ep-placeholder
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=health-ai-development
TOS_ACCESS_KEY=SECRET
TOS_SECRET_KEY=SECRET

# Production only. Mount the App Store Connect In-App Purchase key and the
# Apple public root certificates as read-only files; never bake either secret
# key path target into an image layer.
APP_STORE_ENV=Both
APP_STORE_ISSUER_ID=YOUR_IN_APP_PURCHASE_ISSUER_ID
APP_STORE_KEY_ID=YOUR_IN_APP_PURCHASE_KEY_ID
APP_STORE_PRIVATE_KEY_PATH=/secrets/SubscriptionKey_KEY_ID.p8
APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
APP_STORE_APP_APPLE_ID=1234567890

QUOTA_DAILY_TOKENS=300000
QUOTA_MONTHLY_TOKENS=5000000
