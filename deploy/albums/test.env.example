# Compose interpolation only. Never use this as an application's env_file.
# Private deployment file: create outside Git, chmod 0600, never print its values.
ALBUM_TEST_ENV_FILE=/opt/tellyouwhat/albums-test/.env.albums-test
ALBUM_TEST_SECRET_DIRECTORY=/opt/tellyouwhat/albums-test/secrets
ALBUM_TEST_IMAGE_PREFIX=tellyouwhat-albums-test
# Set to the reviewed source tree's exact 40-character Git commit before build.
ALBUM_TEST_IMAGE_TAG=
ALBUM_TEST_API_PORT=18090
# Check for Docker subnet conflicts first; proxy CIDR must match its host gateway.
ALBUM_TEST_NETWORK_CIDR=172.29.90.0/24
ALBUM_TEST_PROXY_CIDR=172.29.90.1/32
ALBUM_TEST_MYSQL_USER=albums_test
ALBUM_TEST_MYSQL_PASSWORD=
ALBUM_TEST_MYSQL_ROOT_PASSWORD=
ALBUM_TEST_REDIS_PASSWORD=
