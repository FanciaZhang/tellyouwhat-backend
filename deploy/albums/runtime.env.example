# Application env_file: separate from the Compose/root-DB environment file.
# Private file outside Git; chmod 0600. No root database password in this file.
ALBUM_API_HOST=api.albums.tellyouwhat.cn
ALBUM_COS_BUCKET=tellyouwhat-albums-1251995834
ALBUM_COS_REGION=ap-guangzhou
ALBUM_COS_ARCHIVE_SECRET_ID=
ALBUM_COS_ARCHIVE_SECRET_KEY=
ALBUM_COS_UPLOAD_SECRET_ID=
ALBUM_COS_UPLOAD_SECRET_KEY=
ALBUM_APPLE_TEAM_ID=T6DD96HY2B
ALBUM_APPLE_SIGN_IN_KEY_ID=
ALBUM_APPLE_SIGN_IN_KEY_FILE=/album-secrets/apple-sign-in.p8
ALBUM_CREDENTIAL_KEY_FILE=/album-secrets/credential-key.base64
ALBUM_LOGIN_LIMIT_KEY_FILE=/album-secrets/login-limit-key.base64
# Off until album-specific annual SKUs and StoreKit server credentials exist.
# The deployment selects Sandbox (test) or Production; there is no fallback.
ALBUM_SUBSCRIPTIONS_ENABLED=false
ALBUM_APP_STORE_ISSUER_ID=
ALBUM_APP_STORE_KEY_ID=
ALBUM_APP_STORE_KEY_FILE=/album-secrets/album-app-store.p8
ALBUM_APP_STORE_ROOTS_FILE=/album-secrets/apple-app-store-roots.pem
# Required only in production; the album App Store app's numeric ID.
ALBUM_APP_STORE_APP_APPLE_ID=6822133304
# Empty disables notification registration. Choose from the app's aps-environment,
# independently of StoreKit: development or production. This does not enable sending.
ALBUM_PUSH_ENVIRONMENT=
# Requires subscriptions plus notification registration; APNs uses its own key.
# APNs acceptance is not proof of device delivery. Keep off until device acceptance.
ALBUM_RETENTION_PUSH_ENABLED=false
ALBUM_APNS_KEY_ID=
ALBUM_APNS_KEY_FILE=/album-secrets/album-apns.p8
# Off until the HTTPS recipient site, immutable originals and private keys are verified.
# Each file holds a distinct random 32-byte key in canonical standard Base64.
# Files are mounted only in the API, never the App, static site or media worker.
ALBUM_SHARING_ENABLED=false
ALBUM_SHARE_SITE_ORIGIN=https://albums.tellyouwhat.cn
ALBUM_SHARE_KEY_FILE=/album-secrets/share-key.base64
# Retain the prior key during rotation through every active link/retry window.
ALBUM_SHARE_PREVIOUS_KEY_FILE=
# Operational limits, not paid quota. New Apple accounts have zero cloud quota.
ALBUM_MAX_ORIGINAL_BYTES=107374182400
ALBUM_MAX_DERIVED_BYTES=4294967296
ALBUM_PHOTO_PROCESSING_ENABLED=false
ALBUM_VIDEO_PROCESSING_ENABLED=false
# Verified default media queue, 2026-10-11; speed-transcoding queue is not selected.
ALBUM_CI_VIDEO_QUEUE_ID=p543daa336f7a4d4b896654b933f8881b
ALBUM_DERIVED_CLEANUP_ENABLED=false

# Enable only after native change-feed synchronization and recovery acceptance.
ALBUM_TRASH_ENABLED=false

# Permanent account-media deletion: keep off until restricted IAM and full erasure acceptance.
ALBUM_ACCOUNT_MEDIA_ERASURE_ENABLED=false

# Accepted account deletions only; enable after Apple rebinding acceptance.
ALBUM_SUBSCRIPTION_REBINDING_ENABLED=false

# Online account records only. Requires rebinding and complete recovery acceptance.
ALBUM_ACCOUNT_RECORD_ERASURE_ENABLED=false
