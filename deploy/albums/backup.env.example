# Dedicated read-only Albums export credentials. Do not reuse the Health environment.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=albums_test
MYSQL_USER=albums_backup
MYSQL_PASSWORD=replace-with-private-read-only-credential
# Or MYSQL_SOCKET=/private/mysql.sock for an isolated local test.
# Generate independently and escrow separately from encrypted snapshots; never commit the real value.
ALBUM_BACKUP_ENCRYPTION_KEY=replace-with-at-least-256-bits-of-random-key-material
