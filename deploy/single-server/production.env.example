# Copy this file to .env.production. Use upper- and lowercase letters,
# digits, `_`, and `-` for MYSQL_PASSWORD and REDIS_PASSWORD because Compose
# embeds them in DSNs.
IMAGE_TAG=initial
HEALTH_API_DOMAIN=api.health.tellyouwhat.cn
HEALTH_ADMIN_DOMAIN=admin.health.tellyouwhat.cn
ACME_EMAIL=replace-with-certificate-contact@example.com

MYSQL_DATABASE=health_ai
MYSQL_USER=health_ai
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_URL_SAFE_PASSWORD
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

APP_ENV=production
APP_ATTEST_ENV=production
STORAGE_MODE=mysql
PAYLOAD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_BUNDLE_ID=cn.tellyouwhat.healthapp
WORKER_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET
JOB_CAPABILITY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ARK_TIMEOUT_SECONDS=180

# One public endpoint safely accepts signed Production and Sandbox StoreKit data.
APP_STORE_ENV=Both
APP_STORE_ISSUER_ID=REPLACE_WITH_IN_APP_PURCHASE_ISSUER_ID
APP_STORE_KEY_ID=REPLACE_WITH_IN_APP_PURCHASE_KEY_ID
APP_STORE_PRIVATE_KEY_PATH=/secrets/SubscriptionKey.p8
APP_STORE_ROOT_PEM_PATH=/secrets/apple-app-store-roots.pem
APP_STORE_APP_APPLE_ID=REPLACE_WITH_NUMERIC_APP_APPLE_ID

# Use a separate App Store Connect Marketing key. Do not reuse the In-App
# Purchase key mounted by the public gateway.
APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_MARKETING_ISSUER_ID
APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_MARKETING_KEY_ID
APP_STORE_CONNECT_SUBSCRIPTION_ID=REPLACE_WITH_MONTHLY_SUBSCRIPTION_RESOURCE_ID
ADMIN_PREVIEW_SIGNING_KEY=REPLACE_WITH_UNPADDED_BASE64_AT_LEAST_32_RANDOM_BYTES
# Keep false until the admin read-only sync has been verified in production.
ADMIN_WRITES_ENABLED=false

ARK_BASE_URL=https://ark.cn-beijing.volces.com
ARK_API_KEY=REPLACE_WITH_ARK_API_KEY
# Endpoint IDs are created in the Ark console. Text/image operations can start
# with Doubao Seed 2.0 Mini; voice must use an endpoint that accepts its audio input.
ARK_ENDPOINT_VOICE_TRANSCRIPTION=ep-replace-voice
ARK_ENDPOINT_MEAL_PHOTO_CAPTURE=ep-replace-mini
ARK_ENDPOINT_HYDRATION_CUP_ESTIMATE=ep-replace-mini
ARK_ENDPOINT_MEAL_TEXT_CAPTURE=ep-replace-mini
ARK_ENDPOINT_MEAL_DECISION=ep-replace-mini
ARK_ENDPOINT_DIET_ANALYSIS=ep-replace-mini
ARK_ENDPOINT_HEALTH_NUTRITION_ANALYSIS=ep-replace-mini
ARK_ENDPOINT_HEALTH_BEHAVIOR_ANALYSIS=ep-replace-mini

TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=replace-with-private-bucket
TOS_ACCESS_KEY=REPLACE_WITH_IAM_SUBUSER_ACCESS_KEY
TOS_SECRET_KEY=REPLACE_WITH_IAM_SUBUSER_SECRET_KEY

QUOTA_REQUESTS_PER_MINUTE_IP=30
QUOTA_REQUESTS_PER_MINUTE_DEVICE=20
QUOTA_REQUESTS_PER_MINUTE_OPERATION=10
QUOTA_DAILY_TOKENS=300000
QUOTA_MONTHLY_TOKENS=5000000
FREE_RECOGNITION_DAILY_TOKENS=4749312
FREE_RECOGNITION_MONTHLY_TOKENS=147228672
QUOTA_MAX_CONCURRENT_DEVICE=2
