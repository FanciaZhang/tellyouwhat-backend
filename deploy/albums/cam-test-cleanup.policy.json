{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "cos:GetBucketVersioning"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1251995834:tellyouwhat-albums-1251995834/*"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "cos:GetBucketObjectVersions",
        "cos:ListMultipartUploads"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1251995834:tellyouwhat-albums-1251995834/*"
      ],
      "condition": {
        "string_like": {
          "cos:prefix": [
