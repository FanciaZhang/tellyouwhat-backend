IMAGE_TAG=main
IMAGE_REGISTRY_PREFIX=ghcr.io/your-account/tellyouwhat-ai
HEALTH_API_DOMAIN=api.health.tellyouwhat.cn
JOURNAL_API_DOMAIN=api.journal.tellyouwhat.cn
ADMIN_DOMAIN=admin.tellyouwhat.cn
ACME_EMAIL=replace@example.com

MYSQL_DATABASE=tellyouwhat
MYSQL_USER=tellyouwhat
MYSQL_PASSWORD=REPLACE_WITH_SECRET
MYSQL_HOST=10.0.0.6
MYSQL_PORT=3306
REDIS_PASSWORD=REPLACE_WITH_SECRET
REDIS_HOST=10.0.0.4
REDIS_PORT=6379

APP_ENV=production
STORAGE_MODE=mysql
PAYLOAD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
APPLE_TEAM_ID=REPLACE_WITH_TEAM_ID
WORKER_INTERNAL_SECRET=REPLACE_WITH_SECRET
JOB_CAPABILITY_SECRET=REPLACE_WITH_AT_LEAST_32_BYTES

TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=tellyouwhat-ai
TOS_ACCESS_KEY=REPLACE_WITH_SECRET
TOS_SECRET_KEY=REPLACE_WITH_SECRET

HEALTH_API_HOSTS=api.health.tellyouwhat.cn
HEALTH_APP_ATTEST_ENV=production
HEALTH_ARK_API_KEY=REPLACE_WITH_SECRET
HEALTH_SCHEMA_MANIFEST_PATH=/config/schema-manifest.json
HEALTH_ARK_ENDPOINT_VOICE_TRANSCRIPTION=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_MEAL_PHOTO_CAPTURE=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_MEAL_TEXT_CAPTURE=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_MEAL_DECISION=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_DIET_ANALYSIS=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_HEALTH_NUTRITION_ANALYSIS=REPLACE_WITH_ENDPOINT
HEALTH_ARK_ENDPOINT_HEALTH_BEHAVIOR_ANALYSIS=REPLACE_WITH_ENDPOINT
HEALTH_APP_STORE_ENV=Both
HEALTH_APP_STORE_ISSUER_ID=REPLACE_WITH_SECRET
HEALTH_APP_STORE_KEY_ID=REPLACE_WITH_SECRET
HEALTH_APP_STORE_PRIVATE_KEY_PATH=/secrets/health-subscription.p8
HEALTH_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
HEALTH_APP_STORE_APP_APPLE_ID=1234567890

JOURNAL_API_HOSTS=api.journal.tellyouwhat.cn
JOURNAL_APP_ATTEST_ENV=production
JOURNAL_ARK_API_KEY=REPLACE_WITH_SECRET
JOURNAL_ARK_TIMEOUT_SECONDS=90
JOURNAL_ARK_LITE_MODEL_ID=REPLACE_WITH_ENDPOINT
JOURNAL_ARK_PRO_MODEL_ID=REPLACE_WITH_ENDPOINT
JOURNAL_APP_STORE_ENV=Both
JOURNAL_APP_STORE_ISSUER_ID=REPLACE_WITH_SECRET
JOURNAL_APP_STORE_KEY_ID=REPLACE_WITH_SECRET
JOURNAL_APP_STORE_PRIVATE_KEY_PATH=/secrets/journal-subscription.p8
JOURNAL_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
JOURNAL_APP_STORE_APP_APPLE_ID=1234567891

ADMIN_PREVIEW_SIGNING_KEY=REPLACE_WITH_UNPADDED_BASE64
ADMIN_WRITES_ENABLED=false
HEALTH_APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_SECRET
HEALTH_APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_SECRET
HEALTH_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/health-marketing.p8
HEALTH_APP_STORE_CONNECT_SUBSCRIPTION_ID=REPLACE_WITH_RESOURCE_ID
JOURNAL_APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_SECRET
JOURNAL_APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_SECRET
JOURNAL_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/journal-marketing.p8
JOURNAL_APP_STORE_CONNECT_SUBSCRIPTION_ID=REPLACE_WITH_RESOURCE_ID
