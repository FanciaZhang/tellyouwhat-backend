APP_ENV=development
PORT=8080
STORAGE_MODE=mysql
DATABASE_DSN=tellyouwhat:local-only-password@tcp(127.0.0.1:3306)/tellyouwhat?charset=utf8mb4&collation=utf8mb4_0900_ai_ci&parseTime=true
REDIS_URL=redis://127.0.0.1:6379/0
PAYLOAD_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
APPLE_TEAM_ID=YOUR_TEAM_ID
APP_ATTEST_ROOT_PEM_PATH=/config/Apple_App_Attestation_Root_CA.pem
WORKER_INTERNAL_SECRET=ROTATABLE_WORKER_SECRET
WORKER_ASYNC_URL=http://127.0.0.1:8081/internal/jobs/process
JOB_CAPABILITY_SECRET=ROTATABLE_RANDOM_SECRET_AT_LEAST_32_BYTES
TRUSTED_CLIENT_IP_HEADER=X-Real-IP

TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=tellyouwhat-ai-development
TOS_ACCESS_KEY=SECRET
TOS_SECRET_KEY=SECRET

HEALTH_API_HOSTS=api.health.tellyouwhat.cn
HEALTH_APPLE_BUNDLE_ID=cn.tellyouwhat.healthapp
HEALTH_APP_ATTEST_ENV=development
HEALTH_ALLOWED_APP_BUILDS=100
HEALTH_DEV_ACTIVATION_SECRET=ROTATABLE_HEALTH_DEVELOPMENT_SECRET
HEALTH_SCHEMA_MANIFEST_PATH=/config/schema-manifest.json
HEALTH_ARK_BASE_URL=https://ark.cn-beijing.volces.com
HEALTH_ARK_API_KEY=HEALTH_SECRET
HEALTH_ARK_ENDPOINT_VOICE_TRANSCRIPTION=ep-placeholder
HEALTH_ARK_ENDPOINT_MEAL_PHOTO_CAPTURE=ep-placeholder
HEALTH_ARK_ENDPOINT_MEAL_TEXT_CAPTURE=ep-placeholder
HEALTH_ARK_ENDPOINT_MEAL_DECISION=ep-placeholder
HEALTH_ARK_ENDPOINT_DIET_ANALYSIS=ep-placeholder
HEALTH_ARK_ENDPOINT_HEALTH_NUTRITION_ANALYSIS=ep-placeholder
HEALTH_ARK_ENDPOINT_HEALTH_BEHAVIOR_ANALYSIS=ep-placeholder
HEALTH_QUOTA_DAILY_TOKENS=300000
HEALTH_QUOTA_MONTHLY_TOKENS=5000000

JOURNAL_API_HOSTS=api.journal.tellyouwhat.cn
JOURNAL_APPLE_BUNDLE_ID=cn.tellyouwhat.journalapp
JOURNAL_APP_ATTEST_ENV=development
JOURNAL_ALLOWED_APP_BUILDS=100
JOURNAL_DEV_ACTIVATION_SECRET=ROTATABLE_JOURNAL_DEVELOPMENT_SECRET
JOURNAL_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
JOURNAL_ARK_API_KEY=JOURNAL_SECRET
JOURNAL_ARK_LITE_MODEL_ID=ep-placeholder-lite
JOURNAL_ARK_PRO_MODEL_ID=ep-placeholder-pro
JOURNAL_QUOTA_DAILY_TOKENS=100000
JOURNAL_QUOTA_MONTHLY_TOKENS=2000000

# Production commerce is independently configured per App.
HEALTH_APP_STORE_ENV=Both
HEALTH_APP_STORE_ISSUER_ID=YOUR_HEALTH_IN_APP_PURCHASE_ISSUER_ID
HEALTH_APP_STORE_KEY_ID=YOUR_HEALTH_IN_APP_PURCHASE_KEY_ID
HEALTH_APP_STORE_PRIVATE_KEY_PATH=/secrets/health-subscription.p8
HEALTH_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
HEALTH_APP_STORE_APP_APPLE_ID=1234567890

JOURNAL_APP_STORE_ENV=Both
JOURNAL_APP_STORE_ISSUER_ID=YOUR_JOURNAL_IN_APP_PURCHASE_ISSUER_ID
JOURNAL_APP_STORE_KEY_ID=YOUR_JOURNAL_IN_APP_PURCHASE_KEY_ID
JOURNAL_APP_STORE_PRIVATE_KEY_PATH=/secrets/journal-subscription.p8
JOURNAL_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
JOURNAL_APP_STORE_APP_APPLE_ID=1234567891

# Shared admin site, with App Store Connect resources scoped per App.
ADMIN_RP_ID=admin.tellyouwhat.cn
ADMIN_ORIGIN=https://admin.tellyouwhat.cn
ADMIN_PREVIEW_SIGNING_KEY=UNPADDED_BASE64_32_RANDOM_BYTES
ADMIN_WRITES_ENABLED=false
HEALTH_APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID
HEALTH_APP_STORE_CONNECT_KEY_ID=YOUR_KEY_ID
HEALTH_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/health-marketing.p8
HEALTH_APP_STORE_CONNECT_SUBSCRIPTION_ID=YOUR_HEALTH_SUBSCRIPTION_RESOURCE_ID
JOURNAL_APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID
JOURNAL_APP_STORE_CONNECT_KEY_ID=YOUR_KEY_ID
JOURNAL_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/journal-marketing.p8
JOURNAL_APP_STORE_CONNECT_SUBSCRIPTION_ID=YOUR_JOURNAL_SUBSCRIPTION_RESOURCE_ID
