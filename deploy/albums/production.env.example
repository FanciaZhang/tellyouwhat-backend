# Compose interpolation only. Never use this as an application's env_file.
# Private deployment file: create outside Git, chmod 0600, never print its values.
ALBUM_PRODUCTION_ENV_FILE=/opt/tellyouwhat/albums-production/.env.albums-production
ALBUM_PRODUCTION_SECRET_DIRECTORY=/opt/tellyouwhat/albums-production/secrets
ALBUM_PRODUCTION_IMAGE_PREFIX=tellyouwhat-albums-production
# Set to the reviewed source tree's exact 40-character Git commit before build.
ALBUM_PRODUCTION_IMAGE_TAG=
ALBUM_PRODUCTION_API_PORT=18093
# Check for Docker subnet conflicts first; proxy CIDR must match its host gateway.
ALBUM_PRODUCTION_NETWORK_CIDR=172.29.94.0/24
ALBUM_PRODUCTION_PROXY_CIDR=172.29.94.1/32
ALBUM_PRODUCTION_MYSQL_USER=albums_production
ALBUM_PRODUCTION_MYSQL_PASSWORD=
ALBUM_PRODUCTION_MYSQL_ROOT_PASSWORD=
ALBUM_PRODUCTION_REDIS_PASSWORD=

