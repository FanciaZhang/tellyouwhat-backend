# Infrastructure
IMAGE_TAG=initial
IMAGE_REGISTRY_PREFIX=ghcr.io/your-account/tellyouwhat-ai
GOPROXY=https://mirrors.tencent.com/go/
HEALTH_API_DOMAIN=api.health.tellyouwhat.cn
JOURNAL_API_DOMAIN=api.journal.tellyouwhat.cn
ADMIN_DOMAIN=admin.tellyouwhat.cn
ACME_EMAIL=replace-with-certificate-contact@example.com
PUBLIC_PROXY_MODE=docker

# Managed MySQL and Redis private addresses
MYSQL_DATABASE=tellyouwhat
MYSQL_USER=tellyouwhat
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
MYSQL_HOST=10.0.0.6
MYSQL_PORT=3306
REDIS_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
REDIS_HOST=10.0.0.4
REDIS_PORT=6379

# Shared runtime
APP_ENV=production
STORAGE_MODE=mysql
PAYLOAD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
WORKER_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET
JOB_CAPABILITY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=health-ai
TOS_ACCESS_KEY=REPLACE_WITH_IAM_SUBUSER_ACCESS_KEY
TOS_SECRET_KEY=REPLACE_WITH_IAM_SUBUSER_SECRET_KEY

# Health identity, operations, products, Ark routes and quota
HEALTH_API_HOSTS=api.health.tellyouwhat.cn
HEALTH_APPLE_BUNDLE_ID=cn.tellyouwhat.healthapp
HEALTH_APP_ATTEST_ENV=production
HEALTH_SCHEMA_MANIFEST_PATH=/config/schema-manifest.json
HEALTH_MANAGED_AI_PRODUCT_ID=health.premium.subscription.monthly
HEALTH_MANAGED_AI_PRODUCT_IDS=health.premium.subscription.monthly,health.premium.subscription.annual
HEALTH_ARK_BASE_URL=https://ark.cn-beijing.volces.com
HEALTH_ARK_API_KEY=REPLACE_WITH_HEALTH_ARK_API_KEY
HEALTH_ARK_TIMEOUT_SECONDS=180
HEALTH_ARK_ENDPOINT_VOICE_TRANSCRIPTION=ep-replace-voice
HEALTH_ARK_ENDPOINT_MEAL_PHOTO_CAPTURE=ep-replace-mini
HEALTH_ARK_ENDPOINT_HYDRATION_CUP_ESTIMATE=ep-replace-mini
HEALTH_ARK_ENDPOINT_MEAL_TEXT_CAPTURE=ep-replace-mini
HEALTH_ARK_ENDPOINT_MEAL_DECISION=ep-replace-mini
HEALTH_ARK_ENDPOINT_DIET_ANALYSIS=ep-replace-mini
HEALTH_ARK_ENDPOINT_HEALTH_NUTRITION_ANALYSIS=ep-replace-mini
HEALTH_ARK_ENDPOINT_HEALTH_BEHAVIOR_ANALYSIS=ep-replace-mini
HEALTH_QUOTA_REQUESTS_PER_MINUTE_IP=30
HEALTH_QUOTA_REQUESTS_PER_MINUTE_DEVICE=20
HEALTH_QUOTA_REQUESTS_PER_MINUTE_OPERATION=10
HEALTH_QUOTA_DAILY_TOKENS=300000
HEALTH_QUOTA_MONTHLY_TOKENS=5000000
HEALTH_FREE_RECOGNITION_DAILY_TOKENS=4749312
HEALTH_FREE_RECOGNITION_MONTHLY_TOKENS=147228672
HEALTH_QUOTA_MAX_CONCURRENT_DEVICE=2

# Journal identity, fixed organizer models, product and quota
JOURNAL_API_HOSTS=api.journal.tellyouwhat.cn
JOURNAL_APPLE_BUNDLE_ID=cn.tellyouwhat.journalapp
JOURNAL_APP_ATTEST_ENV=production
JOURNAL_MANAGED_AI_PRODUCT_ID=journal.ai.subscription.monthly
JOURNAL_MANAGED_AI_PRODUCT_IDS=journal.ai.subscription.monthly
JOURNAL_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
JOURNAL_ARK_API_KEY=REPLACE_WITH_JOURNAL_ARK_API_KEY
JOURNAL_ARK_TIMEOUT_SECONDS=90
JOURNAL_ARK_LITE_MODEL_ID=ep-replace-lite
JOURNAL_ARK_PRO_MODEL_ID=ep-replace-pro
JOURNAL_QUOTA_REQUESTS_PER_MINUTE_IP=30
JOURNAL_QUOTA_REQUESTS_PER_MINUTE_DEVICE=20
JOURNAL_QUOTA_REQUESTS_PER_MINUTE_OPERATION=10
JOURNAL_QUOTA_DAILY_TOKENS=100000
JOURNAL_QUOTA_MONTHLY_TOKENS=2000000
JOURNAL_QUOTA_MAX_CONCURRENT_DEVICE=2

# App Store In-App Purchase keys. The root certificate bundle is embedded in the image.
HEALTH_APP_STORE_ENV=Both
HEALTH_APP_STORE_ISSUER_ID=REPLACE_WITH_HEALTH_IAP_ISSUER_ID
HEALTH_APP_STORE_KEY_ID=REPLACE_WITH_HEALTH_IAP_KEY_ID
HEALTH_APP_STORE_PRIVATE_KEY_PATH=/secrets/health-subscription.p8
HEALTH_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
HEALTH_APP_STORE_APP_APPLE_ID=REPLACE_WITH_HEALTH_NUMERIC_APP_APPLE_ID
JOURNAL_APP_STORE_ENV=Both
JOURNAL_APP_STORE_ISSUER_ID=REPLACE_WITH_JOURNAL_IAP_ISSUER_ID
JOURNAL_APP_STORE_KEY_ID=REPLACE_WITH_JOURNAL_IAP_KEY_ID
JOURNAL_APP_STORE_PRIVATE_KEY_PATH=/secrets/journal-subscription.p8
JOURNAL_APP_STORE_ROOT_PEM_PATH=/config/apple-app-store-roots.pem
JOURNAL_APP_STORE_APP_APPLE_ID=REPLACE_WITH_JOURNAL_NUMERIC_APP_APPLE_ID

# Shared Passkey admin and per-App App Store Connect Marketing keys
ADMIN_PREVIEW_SIGNING_KEY=REPLACE_WITH_UNPADDED_BASE64_AT_LEAST_32_RANDOM_BYTES
ADMIN_WRITES_ENABLED=false
HEALTH_APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_HEALTH_MARKETING_ISSUER_ID
HEALTH_APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_HEALTH_MARKETING_KEY_ID
HEALTH_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/health-marketing.p8
HEALTH_APP_STORE_CONNECT_SUBSCRIPTION_ID=REPLACE_WITH_HEALTH_SUBSCRIPTION_RESOURCE_ID
JOURNAL_APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_JOURNAL_MARKETING_ISSUER_ID
JOURNAL_APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_JOURNAL_MARKETING_KEY_ID
JOURNAL_APP_STORE_CONNECT_PRIVATE_KEY_PATH=/secrets/journal-marketing.p8
JOURNAL_APP_STORE_CONNECT_SUBSCRIPTION_ID=REPLACE_WITH_JOURNAL_SUBSCRIPTION_RESOURCE_ID
